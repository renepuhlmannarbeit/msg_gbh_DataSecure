xt:text.slice(offset,offset+maxChars),next_offset:Math.min(text.length,offset+maxChars),has_more:offset+maxChars<text.length,total_chars:text.length,content_is_verified_anonymized_markdown:true};}
function listAssets(packageId){const{m}=safeResolvePackage(packageId);return{ok:true,package_id:packageId,assets:(m.assets||[]).filter(a=>a.status==='included').map(a=>({asset_id:a.asset_id,file:a.file,mime_type:a.output_mime,bytes:a.bytes,redactions:a.redactions||0}))};}
function readAsset(packageId,assetId){const{p,m}=safeResolvePackage(packageId),a=(m.assets||[]).find(x=>x.status==='included'&&x.asset_id===assetId);if(!a)throw new SafeError('Sicheres Asset nicht gefunden.');const rel=String(a.file||'');if(!/^assets\/[^/]+$/.test(rel))throw new SafeError('Ungültiger Assetpfad.');const f=safeFile(p,rel.split('/').join(path.sep)),data=fs.readFileSync(f);if(a.sha256&&sha256Buffer(data)!==a.sha256)throw new SafeError('Asset wurde nach Freigabe verändert.');return{ok:true,package_id:packageId,asset_id:assetId,mime_type:a.output_mime,bytes:data.length,__image:{data:data.toString('base64'),mimeType:a.output_mime}};}

function listReviewItems(){const r=roots(),items=[];for(const pkg of fs.readdirSync(r.review,{withFileTypes:true}).filter(x=>x.isDirectory())){const dir=path.join(r.review,pkg.name);for(const f of fs.readdirSync(dir).filter(x=>x.endsWith('.review.json'))){try{const j=JSON.parse(fs.readFileSync(path.join(dir,f),'utf8'));if(!j.approved)items.push({review_id:j.review_id,package_id:j.package_id,asset_id:j.asset_id,reason:j.reason,preview_available:!!j.preview_file,created_at:j.created_at});}catch{}}}return{ok:true,items};}
function safeReviewMeta(reviewId){const r=roots(),s=String(reviewId||'');if(!/^.+__asset-\d{3,}$/.test(s))throw new SafeError('Ungültige Review-ID.');const [pkg,asset]=s.split('__');const dir=path.join(r.review,path.basename(pkg)),meta=path.join(dir,`${asset}.review.json`);if(!fs.existsSync(meta))throw new SafeError('Review-Item nicht gefunden.');const j=JSON.parse(fs.readFileSync(meta,'utf8'));if(j.review_id!==s)throw new SafeError('Review-Metadaten stimmen nicht überein.');return{dir,meta,j};}
function approveReviewAsset(reviewId,confirmed){if(confirmed!==true)throw new SafeError('Visuelles Asset wird nur nach ausdrücklicher menschlicher Datenschutzprüfung freigegeben.');const{dir,meta,j}=safeReviewMeta(reviewId);if(j.approved)return{ok:true,already_approved:true,review_id:reviewId};if(!j.preview_file)throw new SafeError('Für dieses Review-Item existiert kein sicher rasterisierter Preview-Kandidat. Manuelle Konvertierung erforderlich.');const preview=safeFile(dir,j.preview_file);if(j.preview_sha256&&sha256File(preview)!==j.preview_sha256)throw new SafeError('Review-Preview wurde verändert; bitte Dokument neu verarbeiten.');const{p,m}=safeResolvePackage(j.package_id);const data=fs.readFileSync(preview);if(path.extname(preview).toLowerCase()!=='.png')throw new SafeError('Nur metadatafreie PNG-Previews können direkt freigegeben werden.');const assetsDir=path.join(p,'assets');fs.mkdirSync(assetsDir,{recursive:true});const target=`${j.asset_id}_reviewed.png`,dest=path.join(assetsDir,target);fs.copyFileSync(preview,dest);const a=(m.assets||[]).find(x=>x.asset_id===j.asset_id);if(!a)throw new SafeError('Asset fehlt im Paketmanifest.');Object.assign(a,{status:'included',reason:'human_privacy_review_approved',file:`assets/${target}`,output_mime:'image/png',bytes:data.length,sha256:sha256Buffer(data),human_reviewed:true});const md=safeFile(p,m.document);let txt=fs.readFileSync(md,'utf8');txt+=`\n\n### Menschlich freigegebene Grafik ${j.asset_id}\n\n![Geprüfte Grafik](./assets/${target})\n`;fs.writeFileSync(md,txt,'utf8');m.document_sha256=sha256File(md);m.human_visual_reviews=(m.human_visual_reviews||0)+1;fs.writeFileSync(path.join(p,'manifest.json'),JSON.stringify(m,null,2),'utf8');j.approved=true;j.approved_at=new Date().toISOString();fs.writeFileSync(meta,JSON.stringify(j,null,2),'utf8');return{ok:true,review_id:reviewId,package_id:j.package_id,asset_id:j.asset_id,approved:true};}

module.exports={SafeError,roots,genericStatus,openFolder,anonymizeNext,listOutputs,readOutput,listAssets,readAsset,listReviewItems,approveReviewAsset,_test:{detectProfileFromMarkdown,safePackageId,prepareVisual,anonymizeMarkdown,processVisuals}};
