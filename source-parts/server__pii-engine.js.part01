  const cand=normalizeSpaces(m[1]); if(!looksName(cand))continue;
    if(profile==='applicant'||profile==='personnel_profile'){out.push(cand);continue;}
    const before=src.slice(Math.max(0,m.index-45),m.index).toLowerCase();
    const after=src.slice(m.index+m[1].length,m.index+m[1].length+30).toLowerCase();
    if(/(?:herr|frau|dr\.?|prof\.?|von|durch|gegenüber|kontakt|kunde|kundin|ansprechpartner|bewerber|mitarbeiter|vertreter|vertragspartei|für)\s*$/.test(before) || /^\s*(?:,|\(|-|–|—)?\s*(?:e-?mail|telefon|tel\.|kontakt|von|für)\b/.test(after)) out.push(cand);
  }
  return [...new Set(out)];
}


function makeRegistry(){const map=new Map(),counts={PERSON:0,ORG:0,CUSTOMER:0,PROJECT:0};return{
  assign(kind,value){const k=`${kind}:${key(value)}`;if(map.has(k))return map.get(k);const n=++counts[kind];const label=kind==='PERSON'?`[PERSON_${String(n).padStart(3,'0')}]`:kind==='ORG'?`[ORGANISATION_${String(n).padStart(3,'0')}]`:kind==='CUSTOMER'?`[KUNDE_${String(n).padStart(3,'0')}]`:`[PROJEKT_${String(n).padStart(3,'0')}]`;map.set(k,label);return label;},
  map,counts,locations:[]};}

function anonymizePersonnel(text, reg, findings){let out=String(text);
  // Table-style employer/location fields first.
  out=out.replace(/(\|\s*Unternehmen\s*:\s*\|\s*)([^|\n]+)(\|)/gim,(a,p,v,end)=>{const clean=normalizeSpaces(v);if(clean){reg.map.set(`ORG:${key(clean)}`,'[ARBEITGEBER_001]');findings.push({type:'EMPLOYER',value_hash:hashShort(clean)});return p+'[ARBEITGEBER_001] '+end;}return a;});
  out=out.replace(/(\|\s*(?:Standort|Wohnort|Adresse|Ort)\s*:\s*\|\s*)([^|\n]+)(\|)/gim,(a,p,v,end)=>{const clean=normalizeSpaces(v);reg.locations.push(clean,clean.replace(/\s*\([^)]*\)\s*$/,'').trim());findings.push({type:'LOCATION',value_hash:hashShort(v)});return p+'[LOCATION_REDACTED] '+end;});
  // Employer labels first.
  out=out.replace(/^(\s*Unternehmen\s*:\s*)([^\n]+)/gim,(all,prefix,val)=>{const clean=normalizeSpaces(val);if(clean){const ph='[ARBEITGEBER_001]';findings.push({type:'EMPLOYER',value_hash:hashShort(clean)});for(const org of collectOrganizations(clean))reg.map.set(`ORG:${key(org)}`,ph);reg.map.set(`ORG:${key(clean)}`,ph);return prefix+ph;}return all;});
  // Exact location fields are not needed for skill profiles.
  out=out.replace(/^(\s*(?:Standort|Wohnort|Adresse|Ort)\s*:\s*)([^\n]+)/gim,(a,p,v)=>{const clean=normalizeSpaces(v);reg.locations.push(clean,clean.replace(/\s*\([^)]*\)\s*$/,'').trim());findings.push({type:'LOCATION',value_hash:hashShort(v)});return p+'[LOCATION_REDACTED]';});
  // Client/project headings: Organisation – project title, domain-only headings, or known organisation names.
  out=out.replace(/^([^\n]{2,120}?)[ \t]+[–—-][ \t]+([^\n]{3,180})$/gm,(all,left,right)=>{
    const l=normalizeSpaces(left),r=normalizeSpaces(right);
    const orgish=collectOrganizations(l).length>0 || /^[A-Z0-9ÄÖÜ][A-Za-z0-9ÄÖÜäöüß .&'’+\-/]{2,50}$/.test(l) || /\.[a-z]{2,6}$/i.test(l);
    if(!orgish||/^(Zeitraum|Rolle|Funktion|Branche)$/i.test(l))return all;
    const c=reg.assign('CUSTOMER',l),p=reg.assign('PROJECT',r);reg.map.set(`ORG:${key(l)}`,c);findings.push({type:'CUSTOMER',value_hash:hashShort(l)},{type:'PROJECT',value_hash:hashShort(r)});return `${c} – ${p}`;
  });
  // Standalone organisation/domain headings.
  out=out.replace(/^([^\n]{2,100})$/gm,(all,line)=>{const s=normalizeSpaces(line);if(!s||s.startsWith('#')||s.startsWith('[')||s.includes('|'))return all;const isOrg=collectOrganizations(s).length>0||/^[a-z0-9][a-z0-9.-]+\.(?:de|com|net|org|eu)$/i.test(s)||(/^[A-ZÄÖÜ0-9][A-ZÄÖÜ0-9 .&+\-]{2,40}$/.test(s)&&!s.split(/\s+/).some(w=>ROLE_WORDS.has(w.toUpperCase())));if(!isOrg)return all;const ph=reg.assign('CUSTOMER',s);reg.map.set(`ORG:${key(s)}`,ph);findings.push({type:'CUSTOMER',value_hash:hashShort(s)});return ph;});
  // Generalize project periods to years only.
  out=out.replace(/(Zeitraum\s*:\s*)(?:seit\s*)?(\d{1,2})\/(\d{4})\s*[–—-]\s*(\d{1,2})\/(\d{4})/gi,(_,p,_m1,y1,_m2,y2)=>`${p}${y1}–${y2}`);
  out=out.replace(/(Zeitraum\s*:\s*)seit\s*(\d{1,2})\/(\d{4})/gi,(_,p,_m,y)=>`${p}seit ${y}`);
  return out;
}

function scanStructured(text){const found=[];const specs=[['EMAIL',EMAIL_RE],['PHONE',PHONE_RE],['IBAN',IBAN_RE],['BIC',BIC_RE],['IP',IP_RE],['POSTAL_ADDRESS',POSTAL_ADDRESS_RE],['DE_TAX_ID',DE_TAX_RE],['DE_SOCIAL_SECURITY',DE_SV_RE]];for(const [type,re] of specs){re.lastIndex=0;let m;while((m=re.exec(text))){if(String(m[0]).startsWith('['))continue;found.push({type,text:m[0],start:m.index,end:m.index+m[0].length});if(m[0].length===0)re.lastIndex++;}}return found;}
function replaceStructured(text, findings){let out=text;
  const repls=[ [EMAIL_RE,'[EMAIL_REDACTED]','EMAIL'],[IBAN_RE,'[BANK_DATA_REDACTED]','IBAN'],[BIC_RE,'[BANK_DATA_REDACTED]','BIC'],[IP_RE,'[IP_REDACTED]','IP'],[DE_SV_RE,'[ID_REDACTED]','DE_SOCIAL_SECURITY'],[POSTAL_ADDRESS_RE,'[LOCATION_REDACTED]','POSTAL_ADDRESS'] ];
  for(const [re,ph,type] of repls){re.lastIndex=0;out=out.replace(re