eneral'){const nr=/\b[A-ZÄÖÜÀ-Ý][A-Za-zÀ-ÖØ-öø-ÿÄÖÜäöüß'’\-]{2,}(?:[ \t]+[A-ZÄÖÜÀ-Ý][A-Za-zÀ-ÖØ-öø-ÿÄÖÜäöüß'’\-]{2,}){1,2}\b/g;let nm;while((nm=nr.exec(text))){if(looksName(nm[0]))add('PERSON_CANDIDATE',nm.index,nm.index+nm[0].length,nm[0]);}}
