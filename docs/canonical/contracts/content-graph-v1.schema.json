{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/data-secure/content-graph-v1.schema.json",
  "title": "DataSecure Content Graph V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_format", "coordinate_space", "nodes"],
  "properties": {
    "schema": { "const": "data-secure-content-graph/v1" },
    "source_format": { "type": "string", "pattern": "^[a-z0-9]+$(?![\\s\\S])" },
    "coordinate_space": { "const": "normalized-markdown:utf16" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/textNode" },
          { "$ref": "#/$defs/imageNode" }
        ]
      }
    }
  },
  "$defs": {
    "part": {
      "type": "string", "minLength": 1, "maxLength": 500,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029:\\\\])(?!(?:[\\s\\S]*[!/])?\\.{1,2}(?:[!/]|$))[^/!]+(?:/[^/!]+)*(?:!/[^/!]+(?:/[^/!]+)*)*$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "end"],
      "properties": {
        "type": { "const": "TextPositionSelector" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "FragmentSelector" },
        "value": { "$ref": "#/$defs/part" }
      }
    },
    "textNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator"],
      "properties": {
        "id": { "type": "string", "pattern": "^node-[0-9]{6}$" },
        "kind": { "enum": ["text", "table", "metadata"] },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_part", "selector"],
          "properties": {
            "source_part": { "$ref": "#/$defs/part" },
            "selector": { "$ref": "#/$defs/position" }
          }
        }
      }
    },
    "imageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "asset_index", "media_type", "locator"],
      "properties": {
        "id": { "type": "string", "pattern": "^node-[0-9]{6}$" },
        "kind": { "const": "image" },
        "asset_index": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "pattern": "^image/[a-z0-9.+-]+$(?![\\s\\S])" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_part", "selector"],
          "properties": {
            "source_part": { "$ref": "#/$defs/part" },
            "selector": { "$ref": "#/$defs/fragment" }
          }
        }
      }
    }
  }
}
