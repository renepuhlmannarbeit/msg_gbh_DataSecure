{
  "schema": "datasecure-standalone-ui/1",
  "shell_candidate": "tauri-2",
  "transport": "inherited_framed_stdio",
  "network_listener": false,
  "renderer_file_system_access": false,
  "renderer_receives_source_paths": "local-display-only",
  "renderer_receives_raw_content": false,
  "renderer_receives_open_target": false,
  "desktop_host_target_resolution": "sidecar-resolve-rust-open",
  "terminal_presentation_ack": "content-free-generation-correlated",
  "state_source": "polled_public_status_snapshot",
  "initial_view": "home",
  "initial_processing_mode": null,
  "automatic_result_navigation": false,
  "history": {
    "limit": 20,
    "order": "created_at_descending",
    "scope": "standalone-only",
    "actions_bound_to": "batch_id",
    "document_contents": false
  },
  "source_admission": "native-picker-or-native-drag-drop-same-validator",
  "drag_drop": {
    "native_event": "datasecure-native-drop",
    "accepted_shapes": ["files", "one-folder"],
    "starts_processing": false,
    "replaces_prepared_selection": false,
    "app_drop_event_contains_source_paths": false,
    "tauri_builtin_drop_event_contains_paths": true
  },
  "states": [
    "ready",
    "preparing",
    "processing",
    "review_required",
    "stopped",
    "export_pending",
    "results_available",
    "completed_without_results",
    "blocked"
  ],
  "commands": [
    "select_files",
    "select_folder",
    "cancel_admission",
    "start_admitted_batch",
    "get_public_state",
    "get_ui_context",
    "get_run_history",
    "open_history_results",
    "open_history_ledger",
    "continue_history_batch",
    "ack_terminal_presented",
    "continue_current_batch",
    "configure_results",
    "open_current_results",
    "open_local_ledger",
    "open_diagnostic_folder",
    "shutdown"
  ],
  "forbidden_payload_fields": [
    "path",
    "source_path",
    "source_name",
    "raw_content",
    "markdown",
    "ocr_text",
    "mapping",
    "token",
    "environment",
    "command_line"
  ]
}
