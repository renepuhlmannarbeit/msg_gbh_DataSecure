{
  "schema": "datasecure-standalone-ui/1",
  "shell_candidate": "tauri-2",
  "transport": "inherited_framed_stdio",
  "network_listener": false,
  "renderer_file_system_access": false,
  "renderer_receives_source_paths": "local-display-only",
  "renderer_receives_raw_content": "active-review-surface-only",
  "main_renderer_receives_raw_content": "only-while-owned-embedded-or-document-review-active",
  "review_window": {
    "separate_capability": true,
    "local_only": true,
    "draft_lifetime": "active-session-only",
    "close_action": "defer"
  },
  "embedded_review": {
    "activation": "explicit-native-command",
    "mutually_exclusive_with_review_window": true,
    "native_owner_guard": true,
    "close_action": "defer-exact-delivered-session-and-return-without-closing-main"
  },
  "source_catalogue": {
    "identity": "server-owned-opaque-id",
    "selection": "revision-bound-subset",
    "blocked_files": "local-name-and-fixed-reason-only",
    "admission_opt_in": "native-v2-main-asset-only",
    "default_strict_non_standalone_admission": true
  },
  "document_review": {
    "activation": "explicit-native-owner-command",
    "selection_is_decision": false,
    "revision_binding": "document-id-revision-output-sha256-operation-id",
    "run_entity_scope": "immutable-membership-exact-semantic-identity-single-journal-commit",
    "raw_correction": "markdown-only-bounded-explicit-range-replacement",
    "normal_completion": "direct-initial-results-no-post-run-selection-or-export-confirmation",
    "optional_correction_publication": "complete-current-revision-vector-create-only-generation-with-technical-validation",
    "result_opener": "existing-current-revision-and-target-bound-inspection-only-no-repair",
    "ai_export": "selected-approved-current-anonymization-revisions-only",
    "raw_export": "separate-non-anonymized-markdown-copy-namespace",
    "automatic_initial_approval": {
      "default_enabled": false,
      "start_policy": "automatic-conservative",
      "purpose": "standalone-markdown-and-anonymize-content-contract-only",
      "uncertainty": "mask-known-ambiguities-and-ocr-contact-corridors-before-existing-final-gates",
      "authority": "immutable-run-policy-verified-published-basis-revision-zero-only",
      "provenance": "automatic-not-human-reviewed",
      "later_edit_or_revocation": "never-automatically-reapproved"
    },
    "automatic_export": false
  },
  "renderer_receives_open_target": false,
  "desktop_host_target_resolution": "sidecar-resolve-rust-open",
  "terminal_presentation_ack": "content-free-generation-correlated",
  "state_source": "polled_public_status_snapshot",
  "private_state_run_binding": "opaque-batch-id-local-desktop-ipc-only-not-public-cli-status",
  "initial_view": "home",
  "initial_processing_mode": null,
  "default_anonymized_output_naming": "neutral",
  "anonymized_output_naming_modes": ["neutral", "source-with-suffix"],
  "output_naming_confirmation": false,
  "automatic_result_navigation": false,
  "history": {
    "limit": 5,
    "order": "created_at_descending",
    "scope": "standalone-only",
    "actions_bound_to": "batch_id",
    "document_contents": false
  },
  "source_admission": "native-picker-or-native-drag-drop-same-validator",
  "drag_drop": {
    "native_event": "datasecure-native-drop",
    "accepted_shapes": ["files", "one-folder"],
    "starts_processing": false,
    "replaces_prepared_selection": false,
    "app_drop_event_contains_source_paths": false,
    "tauri_builtin_drop_event_contains_paths": true
  },
  "states": [
    "ready",
    "preparing",
    "processing",
    "review_required",
    "stopped",
    "paused",
    "export_pending",
    "export_abandoned",
    "results_available",
    "completed_without_results",
    "failed",
    "blocked"
  ],
  "commands": [
    "select_files",
    "select_folder",
    "remove_admitted_source",
    "cancel_admission",
    "start_admitted_batch",
    "get_public_state",
    "get_ui_context",
    "get_run_history",
    "set_run_history_visibility",
    "get_run_failures",
    "open_history_results",
    "open_history_ledger",
    "open_history_identity_mapping",
    "open_identity_mappings_directory",
    "continue_history_batch",
    "pause_batch",
    "abandon_result_export",
    "skip_ocr_contact_review",
    "get_document_reviews",
    "get_document_review_history_summary",
    "close_document_reviews",
    "get_document_review_chunk",
    "get_document_entities",
    "decide_document_review",
    "decide_document_review_batch",
    "export_approved_documents",
    "publish_result_documents",
    "abandon_document_export",
    "open_document_export",
    "open_recorded_document_export",
    "open_document_identity_overview",
    "open_review_window",
    "open_embedded_review",
    "close_review_window",
    "get_review_session",
    "get_review_chunk",
    "submit_review",
    "continue_review_session",
    "ack_terminal_presented",
    "continue_current_batch",
    "configure_results",
    "open_current_results",
    "open_local_ledger",
    "open_diagnostic_folder",
    "report_blocked_picker",
    "shutdown"
  ],
  "forbidden_payload_fields": [
    "path",
    "source_path",
    "source_name",
    "raw_content",
    "markdown",
    "ocr_text",
    "mapping",
    "token",
    "environment",
    "command_line"
  ]
}
