# Real/sensitive documents: never commit document payloads. The repository is
# private, but a commit is permanent, replicates to every clone and has no
# retention control. CI fails on any tracked file of these types. See SECURITY.md.
*.doc
*.docx
*.docm
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.pptm
*.pdf

# Generated synthetic fixtures. This directory holds build products of
# tests/make-fixtures.js only. Test *source* — shared builders and helper
# processes a test starts by path — belongs in tests/lib/ or tests/helpers/,
# which stay tracked. A helper placed here would silently never reach a clone;
# tests/test-architecture-contracts.js fails if that happens again.
/tests/fixtures/
/docs/acceptance/RC63_UAT_TEST_KIT/inputs/
/docs/acceptance/UAT_TEST_KIT/inputs/
/docs/acceptance/UAT_TEST_KIT/.tmp-uat-*/

